# copy this file to .env and fill in YOUR OWN values - never commit the real .env
GEMINI_API_KEY=your-gemini-key-here
GITHUB_TOKEN=ghp_your-github-token-here
REPO=yourusername/agent-swarm
AGENT_ID=yourname-laptop

# optional knobs (defaults shown)
# POLL_SECONDS=60            # how often to check the board when idle
# SEED_TIMEOUT_SECONDS=3600  # max time one seed.py run may take
# LEASE_MINUTES=90           # a silent claim older than this gets broken
# MAX_RETRIES=2              # failed verifications OR publishes before a task waits for the owner
# VERIFY_TIMEOUT_SECONDS=300 # max time one verify.py run may take (the gate + the independent check)
# ALLOW_SELF_VERIFY=1        # ONLY for solo testing: lets you verify your own results
